// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Jadual Pangkalan Data Aset ICT
model AsetICT {
  id                Int      @id @default(autoincrement())
  
  // -- Maklumat Sekolah --
  sekolah           String
  kodSekolah        String
  
  // -- Spesifikasi Aset --
  kategori          String   @default("")
  jenisTag          String
  jenamaModel       String
  fasa              String
  noSiri            String
  noKontrak         String   @default("")
  noKewPa           String   @default("")
  namaPembekal      String   @default("")
  
  // -- Maklumat Pengguna --
  namaPegawai       String   @default("")
  penempatan        String   @default("")
  noTelefon         String   @default("")
  emailPeribadi     String   @default("")
  
  // -- Maklumat Akses & Akaun --
  emailM365         String   @default("")
  kataLaluanM365    String   @default("")
  idLogMasuk        String   @default("")
  kataLaluanPeranti String   @default("")
  
  createdAt         DateTime @default(now())
}

// Jadual Pangkalan Data Pengguna (Untuk simpan profil & gambar)
model Pengguna {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nama         String
  gambarProfil String?  @db.Text
  peranan      String   @default("admin")
  
  createdAt    DateTime @default(now())
}

// Jadual Pangkalan Data Galeri & Lampiran Dokumen
model Galeri {
  id         Int      @id @default(autoincrement())
  tajuk      String
  kategori   String   @default("DO")
  noRujukan  String   @default("-")
  sekolah    String   @default("SK SENDERUT")
  tarikh     String   @default("-")
  catatan    String?  @default("")
  imejBase64 String?  @db.Text
  userEmail  String?  @default("PENGGUNA")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}